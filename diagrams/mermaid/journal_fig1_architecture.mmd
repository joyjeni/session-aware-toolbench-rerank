    Q["① User Query q_t"]:::input
    H["Session History H_t<br/><i>prior successful calls</i>"]:::history
    PM["Profile Mask m(v,p)<br/><i>crop · district · season · lang</i>"]:::history
    R["② Gemma-4 Dense Retriever<br/>s_d(q,v)"]:::process
    Cand["③ Top-100 Candidates"]:::process
    CO(["Co-Activation Cache<br/>φ_c(v ∣ H)"]):::novel
    SR{{"★④ SessionRerank+<br/>score(v) = w_d·s_d + w_m·m + w_c·φ_c<br/>Eq. (1)"}}:::novel
