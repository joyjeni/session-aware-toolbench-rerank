flowchart TB
    classDef input fill:#EAF2FB,stroke:#1E5A8A,stroke-width:1.5px,color:#0B2545
    classDef process fill:#2E6DA4,stroke:#0B3D62,stroke-width:1.5px,color:#FFFFFF,font-weight:bold
    classDef novel fill:#0B3D62,stroke:#F5A623,stroke-width:3px,color:#FFFFFF,font-weight:bold
    classDef output fill:#E9F7F4,stroke:#0E7C66,stroke-width:1.5px,color:#0B2545,font-weight:bold
