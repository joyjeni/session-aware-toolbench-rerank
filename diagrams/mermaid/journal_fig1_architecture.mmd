    UPD["Edge-Weight Update<br/>w ← (1−ρ)w + δ·1[success]<br/>Eq. (2)"]:::history

    Q -->|"1"| R
    R -->|"2"| Cand
    Cand -->|"3"| SR
    H -->|"4"| CO
    CO -->|"5"| SR
    PM -->|"6"| SR
    SR -->|"7"| OUT
    OUT -.->|"8 success/fail"| UPD
    UPD -.->|"9 reinforced edges"| CO
